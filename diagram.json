    { "type": "wokwi-pushbutton", "id": "btn_plus", "top": 350, "left": 80, "attrs": { "color": "green", "label": "+" } },
    { "type": "wokwi-pushbutton", "id": "btn_minus", "top": 350, "left": 180, "attrs": { "color": "red", "label": "-" } },
    { "type": "wokwi-led", "id": "power_board", "top": 120, "left": 350, "attrs": { "color": "blue", "label": "Силовая плата (PWM)" } },
    { "type": "wokwi-resistor", "id": "terminal_electrode", "top": 100, "left": 480, "attrs": { "value": "0", "label": "ЭЛЕКТРОД (+)" } },
