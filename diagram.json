    [ "btn_plus:1.A", "uno:GND.1", "black", [] ],
    [ "btn_plus:2.A", "uno:2", "green", [] ],
    [ "btn_minus:1.A", "uno:GND.1", "black", [] ],
    [ "btn_minus:2.A", "uno:3", "red", [] ],

    [ "uno:9", "power_board:A", "orange", [] ],
    [ "power_board:C", "uno:GND.2", "black", [] ],

    [ "power_board:A", "terminal_electrode:1", "red", [] ],
    [ "uno:GND.2", "terminal_mass:1", "black", [] ]
